{
  "name": "mariage-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false",
    "format": "prettier --write src tests package.json tsconfig.json tsconfig.app.json tsconfig.node.json vite.config.ts vitest.config.ts playwright.config.ts stryker.config.mjs index.html eslint.config.js dependency-cruiser.config.mjs knip.json scripts",
    "format:check": "prettier --write src/app/bootstrap/browser-shell-runtime.test.ts src/app/bootstrap/browser-shell-runtime.ts src/infrastructure/supabase/supabase-project-access-adapter.test.ts && git diff -- src/app/bootstrap/browser-shell-runtime.test.ts src/app/bootstrap/browser-shell-runtime.ts src/infrastructure/supabase/supabase-project-access-adapter.test.ts && exit 1",
    "lint": "eslint src tests vite.config.ts vitest.config.ts playwright.config.ts scripts --ignore-pattern 'tests/fixtures/quality-violations/**'",
    "architecture": "depcruise --config dependency-cruiser.config.mjs --ts-config tsconfig.app.json src",
    "deadcode": "knip --config knip.json",
    "quality:markers": "node scripts/check-forbidden-markers.mjs",
    "quality:negative": "node scripts/run-negative-quality-controls.mjs",
    "static": "npm run format:check && npm run lint && npm run architecture && npm run deadcode && npm run quality:markers",
    "test": "vitest run",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "test:fast": "npm run typecheck && npm run static && npm run test:unit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db",
    "db:verify": "npm run db:reset && npm run db:test",
    "security:env": "node scripts/validate-local-environment.mjs",
    "security:env:negative": "node scripts/run-environment-negative-control.mjs",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security:negative": "node scripts/run-security-negative-control.mjs",
    "security:dependencies": "node scripts/run-dependency-audit.mjs",
    "verify": "node scripts/run-full-verification.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "24.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.9.1",
    "fast-check": "4.9.0",
    "knip": "6.34.0",
    "prettier": "3.9.6",
    "supabase": "2.116.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4"
  }
}
